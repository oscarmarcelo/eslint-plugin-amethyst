{
	"name": "eslint-plugin-amethyst",
	"version": "0.2.0",
	"description": "Opinionated ESLint rules and configurations, designed to complement XO.",
	"keywords": [
		"eslint",
		"eslintplugin",
		"eslint-plugin",
		"linter",
		"lint",
		"xo"
	],
	"author": "Oscar Marcelo (https://oscarmarcelo.com)",
	"homepage": "https://github.com/oscarmarcelo/eslint-plugin-amethyst#readme",
	"repository": "github:oscarmarcelo/eslint-plugin-amethyst",
	"bugs": "https://github.com/oscarmarcelo/eslint-plugin-amethyst/issues",
	"license": "ISC",
	"type": "module",
	"exports": {
		"default": "./source/index.js"
	},
	"sideEffects": false,
	"files": [
		"source"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"docs": "eslint-doc-generator",
		"test": "xo && eslint-doc-generator --check && c8 -r=text -r=html ava",
		"release": "np"
	},
	"dependencies": {
		"comment-parser": "^1.4.9",
		"detect-newline": "^4.0.1"
	},
	"devDependencies": {
		"ava": "^8.0.1",
		"c8": "^12.0.0",
		"eslint": "^10.12.0",
		"eslint-ava-rule-tester": "^5.0.1",
		"eslint-config-xo": "^5.0.0",
		"eslint-doc-generator": "^3.7.1",
		"eslint-plugin-eslint-plugin": "^7.6.2",
		"np": "^12.1.1",
		"outdent": "^0.8.0",
		"xo": "^5.0.1"
	},
	"peerDependencies": {
		"eslint": ">=10"
	}
}
